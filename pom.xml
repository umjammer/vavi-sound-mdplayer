<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>vavi</groupId>
  <artifactId>vavi-apps-mdplayer</artifactId>
  <version>0.0.22</version>

  <profiles>
    <profile>
      <id>local</id>
      <activation>
        <file>
          <exists>${basedir}/local.properties</exists>
        </file>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>properties-maven-plugin</artifactId>
            <version>1.2.1</version>
            <executions>
              <execution>
                <id>read-properties</id>
                <phase>initialize</phase>
                <goals>
                  <goal>read-project-properties</goal>
                </goals>
                <configuration>
                  <files>
                    <file>${basedir}/local.properties</file>
                  </files>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>spotbugs</id>
      <activation>
        <property>
          <name>spotbugs</name>
          <value/>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>com.github.spotbugs</groupId>
            <artifactId>spotbugs-maven-plugin</artifactId>
            <version>4.8.4.0</version>
            <dependencies>
              <!-- overwrite dependency on spotbugs if you want to specify the version of spotbugs -->
              <dependency>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs</artifactId>
                <version>4.8.4</version>
              </dependency>
              <dependency>
                <groupId>com.formdev</groupId>
                <artifactId>flatlaf</artifactId>
                <version>3.5</version>
              </dependency>
            </dependencies>
            <configuration>
              <plugins>
                <plugin>
                  <groupId>com.h3xstream.findsecbugs</groupId>
                  <artifactId>findsecbugs-plugin</artifactId>
                  <version>1.12.0</version>
                </plugin>
                <plugin>
                  <groupId>com.mebigfatguy.fb-contrib</groupId>
                  <artifactId>fb-contrib</artifactId>
                  <version>7.4.3.sb</version>
                </plugin>
              </plugins>

              <jvmArgs>
                <!--
                 seems not working, use export MAVEN_OPTS=
                 e.g.
                 MAVEN_OPTS=-Dswing.defaultlaf=com.formdev.flatlaf.FlatLightLaf mvn -P spotbugs spotbugs:gui
                 -->
                -Dswing.defaultlaf=com.formdev.flatlaf.FlatLightLaf
              </jvmArgs>
              <systemPropertyVariables>
                <swing.defaultlaf>com.formdev.flatlaf.FlatLightLaf</swing.defaultlaf>
              </systemPropertyVariables>
              <failOnError>false</failOnError>
            </configuration>
            <executions>
              <execution>
                <goals>
                  <goal>check</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>coverage</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <version>0.8.14</version>
            <executions>
              <execution>
                <id>prepare-agent</id>
                <goals>
                  <goal>prepare-agent</goal>
                </goals>
              </execution>
              <execution>
                <id>report</id>
                <goals>
                  <goal>report</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <!-- mvn -P run antrun:run -Dfile='foo.vgz' -->
      <id>run</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <version>3.1.0</version>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <java classname="mdplayer.Program" fork="true">
                  <classpath>
                    <path refid="maven.compile.classpath"/>
                    <path refid="maven.test.classpath"/>
                  </classpath>
                  <jvmarg value="--add-opens=java.base/java.io=ALL-UNNAMED" />
                  <jvmarg value="--add-opens=java.base/sun.nio.ch=ALL-UNNAMED" />
                  <jvmarg value="--add-exports=java.desktop/com.sun.media.sound=ALL-UNNAMED" />
                  <jvmarg value="-Djava.util.logging.config.file=${project.build.testOutputDirectory}/logging.properties" />
                  <!-- jvmarg value="-Dswing.defaultlaf=com.formdev.flatlaf.FlatLightLaf" / -->
                  <jvmarg value="-Dapple.laf.useScreenMenuBar=true" />
                  <jvmarg value="-Dapple.awt.application.name=MDPlayer" />
                  <arg value="${file}" />
                </java>
              </target>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <!-- mvn -P calibrate antrun:run -Dseconds='2' -->
      <id>calibrate</id>
      <properties>
        <args>--dry-run</args>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <version>3.1.0</version>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <java classname="mdplayer.tool.VolumeBalanceCalibrator" fork="true">
                  <classpath>
                    <path refid="maven.compile.classpath"/>
                    <path refid="maven.test.classpath"/>
                  </classpath>
                  <jvmarg value="--add-opens=java.base/java.io=ALL-UNNAMED" />
                  <jvmarg value="--add-opens=java.base/sun.nio.ch=ALL-UNNAMED" />
                  <jvmarg line="--add-exports java.desktop/com.sun.media.sound=ALL-UNNAMED" />
                  <jvmarg value="-Djava.util.logging.config.file=${project.build.testOutputDirectory}/logging.properties" />
                  <jvmarg value="-Djava.awt.headless=true" />
                  <arg value="--seconds" />
                  <arg value="${seconds}" />
                  <arg line="${args}" />
                </java>
              </target>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <!-- mvn -P loudness antrun:run -Dseconds='8' [-Dargs='tmp/zms/Clear.ZMS'] -->
      <id>loudness</id>
      <properties>
        <args/>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <version>3.1.0</version>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <java classname="mdplayer.tool.LoudnessCheck" fork="true">
                  <classpath>
                    <path refid="maven.compile.classpath"/>
                    <path refid="maven.test.classpath"/>
                  </classpath>
                  <jvmarg value="--add-opens=java.base/java.io=ALL-UNNAMED" />
                  <jvmarg value="--add-opens=java.base/sun.nio.ch=ALL-UNNAMED" />
                  <jvmarg line="--add-exports java.desktop/com.sun.media.sound=ALL-UNNAMED" />
                  <jvmarg value="-Djava.util.logging.config.file=${project.build.testOutputDirectory}/logging.properties" />
                  <jvmarg value="-Djava.awt.headless=true" />
                  <arg value="--seconds" />
                  <arg value="${seconds}" />
                  <arg line="${args}" />
                </java>
              </target>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <!-- nested (jar in jar, NOT uber) runnable jar, `java -jar` ready:
           mvn -P nested package -> target/${project.artifactId}-${project.version}-app.jar
           the loader is org.eclipse.jdt.internal.jarinjarloader (eclipse's "package required libraries
           into generated jar"), so each nested jar keeps its own META-INF/services as is -->
      <id>nested</id>
      <properties>
        <nested.dir>${project.build.directory}/nested</nested.dir>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <version>3.8.1</version>
            <executions>
              <execution>
                <!-- the nested jars themselves, they become resources of the outer jar -->
                <id>nested-jars</id>
                <phase>prepare-package</phase>
                <goals>
                  <goal>copy-dependencies</goal>
                </goals>
                <configuration>
                  <outputDirectory>${nested.dir}/lib</outputDirectory>
                  <includeScope>runtime</includeScope>
                </configuration>
              </execution>
              <execution>
                <!-- the same list, in the same (maven resolution) order, for Rsrc-Class-Path below -->
                <id>rsrc-class-path</id>
                <phase>prepare-package</phase>
                <goals>
                  <goal>build-classpath</goal>
                </goals>
                <configuration>
                  <outputProperty>nested.class.path</outputProperty>
                  <includeScope>runtime</includeScope>
                  <prefix>lib</prefix>
                  <fileSeparator>/</fileSeparator>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <version>3.1.0</version>
            <executions>
              <execution>
                <id>nested-classes</id>
                <phase>prepare-package</phase>
                <goals>
                  <goal>run</goal>
                </goals>
                <configuration>
                  <exportAntProperties>true</exportAntProperties>
                  <target>
                    <!-- our own classes, at the root of the outer jar (the "./" of Rsrc-Class-Path) -->
                    <copy todir="${nested.dir}">
                      <fileset dir="${project.build.outputDirectory}"/>
                    </copy>
                    <!-- Rsrc-Class-Path is space separated, and maven trims a lone space out of
                         build-classpath's pathSeparator, so translate the default ':' here -->
                    <loadresource property="rsrc.class.path">
                      <string value="${nested.class.path}"/>
                      <filterchain>
                        <tokenfilter>
                          <replaceregex pattern=":" replace=" " flags="g"/>
                        </tokenfilter>
                      </filterchain>
                    </loadresource>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-jar-plugin</artifactId>
            <version>3.4.2</version>
            <executions>
              <execution>
                <id>nested-jar</id>
                <phase>package</phase>
                <goals>
                  <goal>jar</goal>
                </goals>
                <configuration>
                  <classifier>app</classifier>
                  <classesDirectory>${nested.dir}</classesDirectory>
                  <archive>
                    <manifest>
                      <mainClass>org.eclipse.jdt.internal.jarinjarloader.JarRsrcLoader</mainClass>
                    </manifest>
                    <manifestEntries>
                      <Rsrc-Main-Class>mdplayer.Program</Rsrc-Main-Class>
                      <Rsrc-Class-Path>./ ${rsrc.class.path}</Rsrc-Class-Path>
                      <!-- what the run profile passes on the command line -->
                      <Add-Opens>java.base/java.io java.base/sun.nio.ch</Add-Opens>
                      <Add-Exports>java.desktop/com.sun.media.sound</Add-Exports>
                    </manifestEntries>
                  </archive>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.12.1</version>
        <configuration>
          <source>25</source> <!-- TODO release causes compilation failure why? -->
          <target>25</target>
          <compilerArgs>
            <arg>--add-exports</arg>
            <arg>java.desktop/com.sun.media.sound=ALL-UNNAMED</arg>
          </compilerArgs>
          <!-- https://stackoverflow.com/a/30472473 -->
          <fork>true</fork>
          <showWarnings>true</showWarnings>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <argLine>
            --add-opens=java.base/java.io=ALL-UNNAMED
            --add-opens=java.base/sun.nio.ch=ALL-UNNAMED
            --add-exports java.desktop/com.sun.media.sound=ALL-UNNAMED
            -Djava.util.logging.config.file=src/test/resources/logging.properties
            -Dvavi.test.dev.null=@{dev.null}
            -Dmdplayer.variant.ymf262=@{mdplayer.variant.ymf262}
          </argLine>
          <trimStackTrace>false</trimStackTrace>
        </configuration>
      </plugin>
      <!-- use `mvn -P run antrun:run -Dfile='foo.vgz'` instead-->
    </plugins>
  </build>

